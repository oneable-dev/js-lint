{
  "name": "@oneable/js-lint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/presets/base.d.ts",
      "default": "./dist/presets/base.js"
    },
    "./typescript": {
      "types": "./dist/presets/typescript.d.ts",
      "default": "./dist/presets/typescript.js"
    },
    "./react": {
      "types": "./dist/presets/react.d.ts",
      "default": "./dist/presets/react.js"
    },
    "./react-native": {
      "types": "./dist/presets/react-native.d.ts",
      "default": "./dist/presets/react-native.js"
    },
    "./vitest": {
      "types": "./dist/presets/vitest.d.ts",
      "default": "./dist/presets/vitest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "pnpm build && oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "1.92.0"
  },
  "peerDependencies": {
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
